{
  "name": "agent-sync",
  "productName": "Hydra",
  "version": "0.1.0",
  "description": "Hydra desktop app for coordinating multiple AI agents with shared local context.",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:renderer:dev\" \"npm:app:dev\"",
    "renderer:dev": "vite",
    "server:dev": "nodemon --watch server --ext js --exec node server/index.js",
    "app:dev": "wait-on http://127.0.0.1:5173 http://127.0.0.1:3847/health && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:5173 AGENTSYNC_EXTERNAL_SERVER=1 electron .",
    "start": "cross-env NODE_ENV=production electron .",
    "start:server": "node server/index.js",
    "build:renderer": "vite build",
    "db:init": "node server/db/init.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron": "^35.0.0",
    "express": "^4.21.2",
    "keytar": "^7.9.0",
    "openai": "^6.29.0",
    "playwright": "^1.51.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-git": "^3.33.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.10",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
